{-
    Isprime(n): output 1 if the number is prime, 0 otherwise
    input: n
    output: output
-}

composite := 0;
i := 2;
while i < n and not [composite] do
    j := 1;
    while i*j < n do
        j += 1
    od;
    if i*j == n then
        composite := 1
    else
        i := i + 1
    fi
od;
output := 1 - composite
